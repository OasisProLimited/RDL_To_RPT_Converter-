  "ReportFormulas": [
    {
      "Name": "Title",
      "Text": "switch\r\n(\r\n    {?ObjectId@} = 59, \r\n        switch(\r\n            {@X_Language} = 'DK', 'Varetilgang',\r\n            {@X_Language} = 'DE', 'Wareneingang',\r\n            True, 'Goods Receipt' //Default English\r\n        ),\r\n\r\n\r\n    {?ObjectId@} = 60, \r\n        switch(\r\n            {@X_Language} = 'DK', 'Vareafgang',\r\n            {@X_Language} = 'DE', 'Warenausgang',\r\n            True, 'Goods Issue' //Default English\r\n        ),\r\n    TRUE, 'UNKNOWN TYPE'\r\n)"
    },
