      "Text": "switch(\r\n{?$[CURRENT_LANGUAGE]} = 1, 'HE', //Hebrew\r\n{?$[CURRENT_LANGUAGE]} = 3, 'EN', //English\r\n{?$[CURRENT_LANGUAGE]} = 5, 'PL', //Polish\r\n{?$[CURRENT_LANGUAGE]} = 8, 'GB', //Englis (UK)\r\n{?$[CURRENT_LANGUAGE]} = 9, 'DE', //German\r\n{?$[CURRENT_LANGUAGE]} = 11, 'DK', //Danish\r\n{?$[CURRENT_LANGUAGE]} = 12, 'NO', //Norwegian\r\n{?$[CURRENT_LANGUAGE]} = 13, 'IT', //Italian\r\n{?$[CURRENT_LANGUAGE]} = 14, 'HU', //Hungarian\r\n{?$[CURRENT_LANGUAGE]} = 16, 'NL', //Dutch\r\n{?$[CURRENT_LANGUAGE]} = 17, 'FI', //Finnish\r\n{?$[CURRENT_LANGUAGE]} = 18, 'GR', //Greek\r\n{?$[CURRENT_LANGUAGE]} = 19, 'PT', //Portuguese\r\n{?$[CURRENT_LANGUAGE]} = 20, 'SE', //Swedish\r\n{?$[CURRENT_LANGUAGE]} = 22, 'FR', //French\r\n{?$[CURRENT_LANGUAGE]} = 23, 'ES', //Spanish\r\n{?$[CURRENT_LANGUAGE]} = 24, 'RU', //Russian\r\n{?$[CURRENT_LANGUAGE]} = 25, 'CO', //Spanish (LA)\r\n{?$[CURRENT_LANGUAGE]} = 26, 'CZ', //Czech\r\n{?$[CURRENT_LANGUAGE]} = 27, 'SK', //Slovak\r\nTrue, 'EN' //Unknown (English)\r\n)"
